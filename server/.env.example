# Bharat HealthConnect Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# SQLite database for zero-config local run:
DATABASE_URL="file:./dev.db"

# PostgreSQL connection string (for production/Postgres):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/bharat_healthconnect?schema=public"

# JWT Authentication Secret
JWT_SECRET="your_secure_jwt_token_secret_key"
JWT_EXPIRES_IN="7d"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
