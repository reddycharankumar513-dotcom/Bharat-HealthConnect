{
  "name": "bharat-healthconnect-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Bharat HealthConnect Healthcare Platform",
  "main": "src/index.ts",
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.sqlite.prisma && tsx watch src/index.ts",
    "build": "node scripts/build.js",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/tests/integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
