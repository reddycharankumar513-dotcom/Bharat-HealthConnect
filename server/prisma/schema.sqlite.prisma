generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User and Authentication
model User {
  id              String           @id @default(uuid())
  email           String           @unique
  phone           String?          @unique
  passwordHash    String
  fullName        String
  role            String           @default("PATIENT") // PATIENT, DOCTOR, HOSPITAL_ADMIN, HOSPITAL_STAFF, PHARMACIST, LAB_ADMIN, LAB_STAFF, SUPPLIER, CENTRAL_ADMIN
  status          String           @default("ACTIVE")  // ACTIVE, PENDING_VERIFICATION, SUSPENDED, DEACTIVATED
  avatarUrl       String?
  city            String?
  state           String?
  abhaId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  patientProfile  PatientProfile?
  doctorProfile   DoctorProfile?
  hospitalStaff   HospitalStaff?
  pharmacistProfile PharmacistProfile?
  labStaff        LaboratoryStaff?
  supplier        Supplier?
  notifications   Notification[]
  auditLogs       AuditLog[]
  sales           Sale[]
  inventoryTransactions InventoryTransaction[]
  consentGiven    ConsentRecord[]  @relation("PatientConsent")
  consentReceived ConsentRecord[]  @relation("DoctorConsent")
}

// Patient Profile
model PatientProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth       String?
  gender            String?
  bloodGroup        String?
  address           String?
  emergencyContact  String?      // JSON string or phone
  preferredLanguage String       @default("en")
  allergies         String?      // Comma-separated or JSON
  chronicConditions String?      // Comma-separated or JSON
  dependents        String?      // JSON string of dependents
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  appointments      Appointment[]
  testBookings      TestBooking[]
  orders            MedicineOrder[]
  diagnosticReports DiagnosticReport[]
  admissions        Admission[]
  bedReservations   BedReservation[]
  waitingList       WaitingList[]
  transfers         BedTransfer[]
  discharges        Discharge[]
  inpatientInvoices InpatientInvoice[]
  invoices          Invoice[]
  payments          Payment[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims   InsuranceClaim[]
}

// Hospital
model Hospital {
  id                String          @id @default(uuid())
  name              String
  type              String          @default("Private") // Government, Private, Autonomous
  address           String
  city              String
  state             String
  pincode           String
  phone             String
  emergencyPhone    String
  operatingHours    String          @default("24x7")
  verificationStatus String         @default("VERIFIED") // PENDING, VERIFIED, SUSPENDED
  rating            Float           @default(4.8)
  reviewCount       Int             @default(120)
  bedCapacity       Int             @default(200)
  availableBeds     Int             @default(45)
  icuBeds           Int             @default(12)
  emergencyAvailable Boolean        @default(true)
  ayushmanEmpanelled Boolean        @default(true)
  imageUrl          String?
  departments       String?         // JSON array of strings
  specialties       String?         // JSON array of strings
  lat               Float           @default(17.3850)
  lng               Float           @default(78.4867)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  doctors           DoctorProfile[]
  staff             HospitalStaff[]
  appointments      Appointment[]
  wards             Ward[]
  rooms             Room[]
  beds              Bed[]
  admissions        Admission[]
  bedReservations   BedReservation[]
  waitingList       WaitingList[]
  cleaningTasks     CleaningTask[]
  maintenanceRequests MaintenanceRequest[]
  equipment         MedicalEquipment[]
  inpatientInvoices InpatientInvoice[]
  invoices          Invoice[]
  payments          Payment[]
  insuranceClaims   InsuranceClaim[]
  financialLedgers  FinancialLedger[]
}

// Doctor Profile
model DoctorProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId        String?
  hospital          Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  specialty         String
  subSpecialty      String?
  qualification     String
  registrationNumber String      @unique
  experienceYears   Int          @default(5)
  consultationFee   Float        @default(500)
  languages         String       @default("English, Hindi")
  rating            Float        @default(4.8)
  reviewCount       Int          @default(40)
  about             String?
  treatedSymptoms   String?      // JSON array
  conditions        String?      // JSON array
  availableDays     String       @default("Mon, Tue, Wed, Thu, Fri, Sat")
  availableSlots    String       @default("09:00 AM, 10:00 AM, 11:30 AM, 02:00 PM, 04:00 PM")
  verified          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  appointments      Appointment[]
  admissions        Admission[]
  discharges        Discharge[]
  invoices          Invoice[]
}

// Hospital Staff
model HospitalStaff {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId      String
  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department      String
  designation     String
  shift           String       @default("Day")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// Pharmacy
model Pharmacy {
  id                String       @id @default(uuid())
  name              String
  licenseNumber     String       @unique
  address           String
  city              String
  state             String
  pincode           String
  phone             String
  operatingHours    String       @default("08:00 AM - 10:00 PM")
  verificationStatus String      @default("VERIFIED") // PENDING, VERIFIED, SUSPENDED
  rating            Float        @default(4.7)
  deliveryAvailable Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  pharmacists       PharmacistProfile[]
  inventories       Inventory[]
  batches           MedicineBatch[]
  sales             Sale[]
  orders            MedicineOrder[]
  purchaseOrders    PurchaseOrder[]
  purchaseRequests  PurchaseRequest[]
  transactions      InventoryTransaction[]
}

// Pharmacist Profile
model PharmacistProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId      String
  pharmacy        Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  regNumber       String       @unique
  qualification   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// Medicine Master Catalog
model Medicine {
  id                String          @id @default(uuid())
  name              String
  brandName         String?
  genericName       String
  category          String          // Antibiotic, Anti-Diabetic, Cardiovascular, etc.
  dosageForm        String          // Tablet, Capsule, Syrup, Injection, Ointment
  strength          String?         // 500mg, 10mg, etc.
  manufacturer      String?
  description       String?
  requiresPrescription Boolean      @default(false)
  unitPrice         Float
  minThreshold      Int             @default(20)
  suggestedReorderQty Int           @default(100)
  storageCondition  String          @default("Store below 25°C in a dry place")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  inventories       Inventory[]
  batches           MedicineBatch[]
  orderItems        MedicineOrderItem[]
  purchaseOrders    PurchaseOrder[]
  supplierProducts  SupplierProduct[]
}

// Medicine Inventory per Pharmacy
model Inventory {
  id                String          @id @default(uuid())
  pharmacyId        String
  pharmacy          Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  totalQuantity     Int             @default(0)
  reservedQuantity  Int             @default(0) // Concurrency safe reservation for online orders
  lowStockThreshold Int             @default(20)
  status            String          @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  batches           MedicineBatch[]

  @@unique([pharmacyId, medicineId])
}

// Medicine Batch with QR code
model MedicineBatch {
  id                String          @id @default(uuid())
  pharmacyId        String
  pharmacy          Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  inventoryId       String?
  inventory         Inventory?      @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  batchNumber       String
  qrCodeValue       String          @unique // Unique QR code string scanned by camera
  sku               String
  quantity          Int
  unitPrice         Float
  costPrice         Float?
  expiryDate        String          // YYYY-MM-DD
  isRecalled        Boolean         @default(false)
  supplierId        String?
  supplier          Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sales             Sale[]
  orderItems        MedicineOrderItem[]
  transactions      InventoryTransaction[]

  @@index([qrCodeValue])
  @@index([batchNumber])
}

// Inventory Transaction Ledger
model InventoryTransaction {
  id                String          @id @default(uuid())
  transactionRef    String          @unique
  pharmacyId        String
  pharmacy          Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineName      String
  batchNumber       String
  batchId           String?
  batch             MedicineBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantityBefore    Int
  quantityChange    Int             // Negative for sales/reservations, positive for receipts
  quantityAfter     Int
  source            String          // QR_SALE, ONLINE_ORDER, MANUAL_ADJUSTMENT, SUPPLIER_RECEIPT
  staffId           String?
  staff             User?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName         String?
  status            String          @default("COMPLETED") // COMPLETED, REVERTED
  notes             String?
  timestamp         DateTime        @default(now())

  @@index([transactionRef])
  @@index([pharmacyId])
}

// Pharmacy Sale (e.g. from QR scan)
model Sale {
  id                String          @id @default(uuid())
  saleRef           String          @unique
  pharmacyId        String
  pharmacy          Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  batchId           String
  batch             MedicineBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pharmacistId      String
  pharmacist        User            @relation(fields: [pharmacistId], references: [id], onDelete: Cascade)
  quantitySold      Int
  unitPrice         Float
  totalAmount       Float
  paymentMode       String          @default("CASH") // CASH, UPI, CARD
  customerName      String?
  customerPhone     String?
  soldAt            DateTime        @default(now())

  @@index([saleRef])
}

// Medical Supplier
model Supplier {
  id                String          @id @default(uuid())
  userId            String?         @unique
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name              String
  contactPerson     String
  phone             String
  email             String
  city              String
  state             String?
  gstNumber         String          @unique
  rating            Float           @default(4.9)
  leadTimeDays      Int             @default(2)
  status            String          @default("VERIFIED") // PENDING, VERIFIED, SUSPENDED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  products          SupplierProduct[]
  purchaseOrders    PurchaseOrder[]
  purchaseRequests  PurchaseRequest[]
  batches           MedicineBatch[]
}

// Supplier Product Catalog
model SupplierProduct {
  id                String       @id @default(uuid())
  supplierId        String
  supplier          Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine     @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  wholesalePrice    Float
  minOrderQuantity  Int          @default(50)
  inStock           Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([supplierId, medicineId])
}

// Purchase Request / Purchase Order
model PurchaseOrder {
  id                String          @id @default(uuid())
  poNumber          String          @unique
  pharmacyId        String
  pharmacy          Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  quantity          Int
  unitPrice         Float
  totalAmount       Float
  status            String          @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, ORDERED, DISPATCHED, DELIVERED, RECEIVED, CANCELLED
  estimatedDelivery String?
  approvedBy        String?
  receivedAt        DateTime?
  receivedBatchNumber String?
  receivedExpiryDate String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([poNumber])
}

model PurchaseRequest {
  id                String       @id @default(uuid())
  pharmacyId        String
  pharmacy          Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  medicineName      String
  requestedQty      Int
  estimatedPrice    Float?
  status            String       @default("SUBMITTED") // SUBMITTED, ACCEPTED, REJECTED
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// Patient Online Medicine Orders
model MedicineOrder {
  id                String              @id @default(uuid())
  orderNumber       String              @unique
  patientId         String
  patient           PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacyId        String
  pharmacy          Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  totalAmount       Float
  status            String              @default("PENDING") // PENDING, PHARMACY_REVIEW, CONFIRMED, PREPARING, READY_FOR_PICKUP, DISPATCHED, DELIVERED, REJECTED, CANCELLED
  deliveryType      String              @default("DELIVERY") // DELIVERY, PICKUP
  deliveryAddress   String?
  prescriptionUrl   String?
  pharmacistNotes   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items             MedicineOrderItem[]

  @@index([orderNumber])
}

model MedicineOrderItem {
  id                String          @id @default(uuid())
  orderId           String
  order             MedicineOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId           String?
  batch             MedicineBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity          Int
  unitPrice         Float
  totalPrice        Float
}

// Diagnostic Laboratory
model DiagnosticLaboratory {
  id                String          @id @default(uuid())
  name              String
  licenseNumber     String          @unique
  address           String
  city              String
  state             String
  pincode           String
  phone             String
  operatingHours    String          @default("07:00 AM - 08:00 PM")
  verificationStatus String         @default("VERIFIED") // PENDING, VERIFIED, SUSPENDED
  rating            Float           @default(4.9)
  homeCollectionAvailable Boolean   @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  staff             LaboratoryStaff[]
  tests             DiagnosticTest[]
  bookings          TestBooking[]
  reports           DiagnosticReport[]
}

// Laboratory Staff
model LaboratoryStaff {
  id                String               @id @default(uuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  laboratoryId      String
  laboratory        DiagnosticLaboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  designation       String               // Pathologist, Senior Lab Technician, Phlebotomist
  licenseNumber     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

// Diagnostic Test Catalog
model DiagnosticTest {
  id                String               @id @default(uuid())
  laboratoryId      String?
  laboratory        DiagnosticLaboratory? @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)
  name              String
  code              String               @unique
  category          String               // Biochemistry, Hematology, Microbiology, Pathology, Radiology
  priceINR          Float
  tatHours          Int                  @default(24)
  sampleType        String               // Blood, Urine, Saliva, Swab
  fastingRequired   Boolean              @default(false)
  description       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  bookings          TestBooking[]
}

// Test Booking
model TestBooking {
  id                String               @id @default(uuid())
  bookingRef        String               @unique
  patientId         String
  patient           PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testId            String
  test              DiagnosticTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  laboratoryId      String
  laboratory        DiagnosticLaboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  collectionType    String               @default("Lab Visit") // Home Collection, Lab Visit
  scheduledDate     String
  scheduledTime     String
  status            String               @default("BOOKED") // BOOKED, SAMPLE_COLLECTED, PROCESSING, COMPLETED, REPORT_UPLOADED, AVAILABLE_TO_PATIENT, CANCELLED
  sampleBarcode     String?
  technicianName    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  sample            Sample?
  report            DiagnosticReport?

  @@index([bookingRef])
}

// Phlebotomy Sample
model Sample {
  id                String          @id @default(uuid())
  bookingId         String          @unique
  booking           TestBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barcode           String          @unique
  sampleType        String
  collectedAt       DateTime?
  collectorName     String?
  storageTemp       String?         @default("2-8°C")
  status            String          @default("COLLECTED") // COLLECTED, IN_TRANSIT, RECEIVED_AT_LAB, PROCESSING, DISCARDED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// Diagnostic Report
model DiagnosticReport {
  id                String               @id @default(uuid())
  bookingId         String               @unique
  booking           TestBooking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patientId         String
  patient           PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  laboratoryId      String
  laboratory        DiagnosticLaboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  testName          String
  reportDate        String
  fileUrl           String               // Secure server path (never public)
  fileName          String
  fileSize          String
  mimeType          String
  pathologistName   String
  summaryNotes      String?
  status            String               @default("AVAILABLE") // AVAILABLE, REVISED, RECALLED
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  versions          ReportVersion[]

  @@index([patientId])
}

// Report Version History for controlled corrections
model ReportVersion {
  id                String            @id @default(uuid())
  reportId          String
  report            DiagnosticReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  versionNumber     Int               @default(1)
  fileUrl           String
  fileName          String
  correctionReason  String
  correctedBy       String
  createdAt         DateTime          @default(now())
}

// Doctor Appointments
model Appointment {
  id                String          @id @default(uuid())
  patientId         String
  patient           PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId        String
  hospital          Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  date              String          // YYYY-MM-DD
  timeSlot          String          // 10:00 AM
  status            String          @default("Scheduled") // Scheduled, Checked In, In Consultation, Completed, Cancelled, Rescheduled
  type              String          @default("In-Person") // In-Person, Tele-Consultation
  fee               Float           @default(500)
  paymentStatus     String          @default("Paid")      // Paid, Pending, Refunded
  symptoms          String?
  consultationNotes String?
  prescriptions     String?         // JSON array of prescribed items
  labReferrals      String?         // JSON array of test names
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([doctorId, date, timeSlot]) // Prevent duplicate bookings on the same slot!
  @@index([patientId])
  @@index([doctorId])
}

// Patient Consent Records for Doctor Access
model ConsentRecord {
  id                String       @id @default(uuid())
  patientId         String
  patient           User         @relation("PatientConsent", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            User         @relation("DoctorConsent", fields: [doctorId], references: [id], onDelete: Cascade)
  scope             String       @default("ALL_RECORDS") // ALL_RECORDS, DIAGNOSTIC_ONLY, PRESCRIPTION_ONLY
  status            String       @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt         DateTime?
  grantedAt         DateTime     @default(now())
  revokedAt         DateTime?
}

// In-App Notifications
model Notification {
  id                String       @id @default(uuid())
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole        String?      // If for all users of a role
  title             String
  message           String
  category          String       @default("system") // appointment, diagnostic, pharmacy, emergency, system
  read              Boolean      @default(false)
  actionUrl         String?
  createdAt         DateTime     @default(now())

  @@index([userId])
}

// Security & Audit Log
model AuditLog {
  id                String       @id @default(uuid())
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userRole          String?
  action            String       // LOGIN, LOGOUT, SALE_QR, REPORT_UPLOAD, REPORT_VIEW, ORDER_RESERVE, STOCK_ADJUST, PROVIDER_VERIFY
  resource          String       // Pharmacy, DiagnosticReport, User, Order
  resourceId        String?
  ipAddress         String?
  userAgent         String?
  details           String?      // JSON or description
  timestamp         DateTime     @default(now())

  @@index([action])
  @@index([userId])
}

// ==========================================
// BED MANAGEMENT & INPATIENT OPERATIONS
// ==========================================

model Ward {
  id              String        @id @default(uuid())
  hospitalId      String
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name            String
  code            String
  department      String
  wardType        String        // GENERAL, PRIVATE, SEMI_PRIVATE, ICU, NICU, PICU, EMERGENCY, MATERNITY, ISOLATION
  floor           String        @default("1st Floor")
  capacity        Int           @default(20)
  supervisorName  String?
  supervisorPhone String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rooms           Room[]
  beds            Bed[]
  equipment       MedicalEquipment[]
  nursingAssignments NursingAssignment[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model Room {
  id              String        @id @default(uuid())
  wardId          String
  ward            Ward          @relation(fields: [wardId], references: [id], onDelete: Cascade)
  hospitalId      String
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  roomNumber      String
  roomType        String        // SINGLE, DOUBLE, DELUXE, SUITE, WARD_SHARED
  capacity        Int           @default(1)
  currentOccupancy Int          @default(0)
  dailyRate       Float         @default(1500)
  facilities      String?       // JSON array: ["AC", "Attached Bath", "Oxygen Port", "Nurse Call Bell"]
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  beds            Bed[]

  @@unique([wardId, roomNumber])
  @@index([wardId])
  @@index([hospitalId])
}

model Bed {
  id                  String             @id @default(uuid())
  hospitalId          String
  hospital            Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  wardId              String
  ward                Ward               @relation(fields: [wardId], references: [id], onDelete: Cascade)
  roomId              String
  room                Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber           String
  bedCategory         String             // STANDARD, ICU, EMERGENCY, MATERNITY, ISOLATION, PEDIATRIC
  bedType             String             @default("SEMI_ELECTRIC") // MANUAL, SEMI_ELECTRIC, FULL_ELECTRIC, BARIATRIC
  dailyTariff         Float              @default(1200)
  facilities          String?            // JSON array: ["Oxygen Port", "IV Stand", "Cardiac Monitor Plug"]
  status              String             @default("AVAILABLE") // AVAILABLE, RESERVED, OCCUPIED, CLEANING_REQUIRED, UNDER_MAINTENANCE, BLOCKED
  currentPatientId    String?
  currentAdmissionId  String?
  lastCleanedAt       DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  admissions          Admission[]
  bedAllocations      BedAllocation[]
  bedReservations     BedReservation[]
  fromTransfers       BedTransfer[]      @relation("FromBed")
  toTransfers         BedTransfer[]      @relation("ToBed")
  cleaningTasks       CleaningTask[]
  maintenanceRequests MaintenanceRequest[]
  equipment           MedicalEquipment[]
  discharges          Discharge[]

  @@unique([hospitalId, bedNumber])
  @@index([hospitalId])
  @@index([wardId])
  @@index([roomId])
  @@index([status])
}

model Admission {
  id                    String             @id @default(uuid())
  admissionNumber       String             @unique
  patientId             String
  patient               PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId              String?
  doctor                DoctorProfile?     @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  hospitalId            String
  hospital              Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bedId                 String?
  bed                   Bed?               @relation(fields: [bedId], references: [id], onDelete: SetNull)
  admissionDate         DateTime           @default(now())
  admissionType         String             @default("DIRECT") // EMERGENCY, PLANNED, DIRECT, REFERRAL
  diagnosis             String
  clinicalNotes         String?
  department            String
  requestedWardType     String             @default("GENERAL")
  admissionStatus       String             @default("REQUESTED") // REQUESTED, APPROVED, WAITING_FOR_BED, ADMITTED, TRANSFERRED, DISCHARGED, CANCELLED
  priority              String             @default("NORMAL") // EMERGENCY, HIGH, NORMAL, LOW
  expectedDischargeDate DateTime?
  actualDischargeDate   DateTime?
  dailyProgressNotes    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  bedAllocations        BedAllocation[]
  transfers             BedTransfer[]
  discharge             Discharge?
  inpatientInvoice      InpatientInvoice?

  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
  @@index([admissionStatus])
}

model BedAllocation {
  id              String        @id @default(uuid())
  admissionId     String
  admission       Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  bedId           String
  bed             Bed           @relation(fields: [bedId], references: [id], onDelete: Cascade)
  allocatedAt     DateTime      @default(now())
  releasedAt      DateTime?
  allocatedBy     String
  reason          String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([admissionId])
  @@index([bedId])
}

model BedReservation {
  id              String        @id @default(uuid())
  hospitalId      String
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientId       String
  patient         PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bedId           String
  bed             Bed           @relation(fields: [bedId], references: [id], onDelete: Cascade)
  reservedFrom    DateTime      @default(now())
  reservedUntil   DateTime
  status          String        @default("ACTIVE") // ACTIVE, CONFIRMED, EXPIRED, CANCELLED
  notes           String?
  reservedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([hospitalId])
  @@index([bedId])
  @@index([status])
}

model WaitingList {
  id                  String        @id @default(uuid())
  hospitalId          String
  hospital            Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientId           String
  patient             PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedWardType   String        @default("GENERAL")
  bedCategory         String        @default("STANDARD")
  priority            String        @default("NORMAL") // EMERGENCY, HIGH, NORMAL, LOW
  isolationRequired   Boolean       @default(false)
  oxygenRequired      Boolean       @default(false)
  ventilatorRequired  Boolean       @default(false)
  status              String        @default("WAITING") // WAITING, ALLOCATED, CANCELLED
  waitingSince        DateTime      @default(now())
  allocatedBedId      String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([hospitalId])
  @@index([status])
  @@index([priority])
}

model BedTransfer {
  id              String        @id @default(uuid())
  admissionId     String
  admission       Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patientId       String
  patient         PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromBedId       String
  fromBed         Bed           @relation("FromBed", fields: [fromBedId], references: [id], onDelete: Cascade)
  toBedId         String
  toBed           Bed           @relation("ToBed", fields: [toBedId], references: [id], onDelete: Cascade)
  transferReason  String
  doctorApproval  String?
  staffName       String
  transferDate    DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([admissionId])
  @@index([fromBedId])
  @@index([toBedId])
}

model Discharge {
  id                    String        @id @default(uuid())
  admissionId           String        @unique
  admission             Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patientId             String
  patient               PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId              String?
  doctor                DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  bedId                 String?
  bed                   Bed?          @relation(fields: [bedId], references: [id], onDelete: SetNull)
  dischargeDate         DateTime      @default(now())
  dischargeType         String        @default("NORMAL") // NORMAL, DAMA, TRANSFER_HOSPITAL, EMERGENCY, DECEASED
  finalDiagnosis        String
  treatmentSummary      String
  prescribedMedicines   String?
  followUpInstructions String?
  billingCleared        Boolean       @default(false)
  authorizedBy          String
  createdAt             DateTime      @default(now())

  @@index([patientId])
}

model CleaningTask {
  id                String        @id @default(uuid())
  hospitalId        String
  hospital          Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bedId             String
  bed               Bed           @relation(fields: [bedId], references: [id], onDelete: Cascade)
  assignedStaffName String?
  status            String        @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED, VERIFIED
  startedAt         DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  verifiedBy        String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([hospitalId])
  @@index([bedId])
  @@index([status])
}

model MaintenanceRequest {
  id                  String        @id @default(uuid())
  hospitalId          String
  hospital            Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bedId               String
  bed                 Bed           @relation(fields: [bedId], references: [id], onDelete: Cascade)
  issueDescription    String
  priority            String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status              String        @default("REPORTED") // REPORTED, IN_PROGRESS, COMPLETED, CANCELLED
  assignedTechnician  String?
  reportedBy          String?
  completedAt         DateTime?
  resolutionNotes     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([hospitalId])
  @@index([bedId])
  @@index([status])
}

model MedicalEquipment {
  id              String        @id @default(uuid())
  hospitalId      String
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  wardId          String?
  ward            Ward?         @relation(fields: [wardId], references: [id], onDelete: SetNull)
  bedId           String?
  bed             Bed?          @relation(fields: [bedId], references: [id], onDelete: SetNull)
  name            String
  code            String        @unique
  equipmentType   String        // VENTILATOR, OXYGEN_CYLINDER, CARDIAC_MONITOR, INFUSION_PUMP, WHEELCHAIR, DEFIBRILLATOR
  status          String        @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE, FAULTY
  serialNumber    String?
  lastServicedAt  DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([hospitalId])
  @@index([wardId])
  @@index([bedId])
  @@index([equipmentType])
}

model NursingAssignment {
  id              String        @id @default(uuid())
  wardId          String
  ward            Ward          @relation(fields: [wardId], references: [id], onDelete: Cascade)
  nurseName       String
  shift           String        @default("Morning (08:00 - 16:00)")
  dutyDate        String
  assignedBeds    String?
  createdAt       DateTime      @default(now())

  @@index([wardId])
}

model InpatientInvoice {
  id                    String        @id @default(uuid())
  invoiceNumber         String        @unique
  admissionId           String        @unique
  admission             Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patientId             String
  patient               PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId            String
  hospital              Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bedCharges            Float         @default(0)
  roomCharges           Float         @default(0)
  icuCharges            Float         @default(0)
  nursingCharges        Float         @default(0)
  doctorCharges         Float         @default(0)
  labCharges            Float         @default(0)
  pharmacyCharges       Float         @default(0)
  procedureCharges      Float         @default(0)
  totalAmount           Float         @default(0)
  discountAmount        Float         @default(0)
  insuranceClaimAmount  Float         @default(0)
  paidAmount            Float         @default(0)
  outstandingBalance    Float         @default(0)
  status                String        @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, WAIVED
  paymentHistory        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([patientId])
  @@index([hospitalId])
}

// ==========================================
// PAYMENTS & FINANCIAL MANAGEMENT MODULE
// ==========================================

model Invoice {
  id                    String            @id @default(uuid())
  invoiceNumber         String            @unique
  patientId             String
  patient               PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId            String?
  hospital              Hospital?         @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  doctorId              String?
  doctor                DoctorProfile?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointmentId         String?
  admissionId           String?
  orderId               String?
  testBookingId         String?
  category              String            @default("CONSULTATION") // CONSULTATION, INPATIENT, PHARMACY, DIAGNOSTIC, EMERGENCY, PROCEDURE
  subTotal              Float             @default(0)
  discountAmount        Float             @default(0)
  discountReason        String?
  taxAmount             Float             @default(0)
  totalAmount           Float             @default(0)
  insuranceCovered      Float             @default(0)
  paidAmount            Float             @default(0)
  outstandingBalance    Float             @default(0)
  status                String            @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, CANCELLED, REFUNDED
  dueDate               DateTime?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 InvoiceItem[]
  payments              Payment[]
  refunds               Refund[]
  insuranceClaims       InsuranceClaim[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([status])
  @@index([category])
}

model InvoiceItem {
  id                    String            @id @default(uuid())
  invoiceId             String
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceCategory       String            // DOCTOR_CONSULTATION, MEDICINE, LAB_TEST, BED_CHARGE, ICU_CHARGE, NURSING, PROCEDURE, EQUIPMENT
  description           String
  quantity              Int               @default(1)
  unitPrice             Float
  totalPrice            Float
  taxRate               Float             @default(0)
  createdAt             DateTime          @default(now())

  @@index([invoiceId])
}

model Payment {
  id                    String            @id @default(uuid())
  paymentReference      String            @unique
  invoiceId             String
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientId             String
  patient               PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId            String?
  hospital              Hospital?         @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  amount                Float
  paymentMethod         String            // RAZORPAY_UPI, RAZORPAY_CARD, RAZORPAY_NETBANKING, CASH, PMJAY_VOUCHER, INSURANCE_DIRECT
  paymentGateway        String            @default("RAZORPAY")
  gatewayOrderId        String?
  gatewayPaymentId      String?
  gatewaySignature      String?
  status                String            @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED, REFUNDED
  idempotencyKey        String?           @unique
  recordedBy            String?
  failureReason         String?
  paidAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  transactions          PaymentTransaction[]
  refunds               Refund[]

  @@index([invoiceId])
  @@index([patientId])
  @@index([status])
}

model PaymentTransaction {
  id                    String            @id @default(uuid())
  paymentId             String
  payment               Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transactionType       String            // CHARGE, REFUND, CHARGEBACK, ADJUSTMENT
  amount                Float
  gatewayStatus         String?
  gatewayPayload        String?
  createdAt             DateTime          @default(now())

  @@index([paymentId])
}

model Refund {
  id                    String            @id @default(uuid())
  refundReference       String            @unique
  paymentId             String
  payment               Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount                Float
  reason                String
  status                String            @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, PROCESSED
  gatewayRefundId       String?
  requestedBy           String
  approvedBy            String?
  processedAt           DateTime?
  remarks               String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([paymentId])
  @@index([invoiceId])
  @@index([status])
}

model InsurancePolicy {
  id                    String            @id @default(uuid())
  patientId             String
  patient               PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerName          String
  policyNumber          String            @unique
  policyHolderName      String
  relationship          String            @default("SELF")
  coverageAmount        Float
  remainingAmount       Float
  coPayPercentage       Float             @default(0)
  validFrom             DateTime
  validTill             DateTime
  tpaName               String?
  status                String            @default("ACTIVE")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  claims                InsuranceClaim[]

  @@index([patientId])
  @@index([policyNumber])
}

model InsuranceClaim {
  id                    String            @id @default(uuid())
  claimNumber           String            @unique
  policyId              String
  policy                InsurancePolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientId             String
  patient               PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId            String
  hospital              Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  claimAmount           Float
  approvedAmount        Float             @default(0)
  rejectedAmount        Float             @default(0)
  patientPayable        Float             @default(0)
  status                String            @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, SETTLED
  preAuthCode           String?
  remarks               String?
  settledAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([policyId])
  @@index([invoiceId])
  @@index([patientId])
  @@index([hospitalId])
}

model FinancialLedger {
  id                    String            @id @default(uuid())
  ledgerRef             String            @unique
  hospitalId            String?
  hospital              Hospital?         @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  entryType             String            // CREDIT, DEBIT
  category              String            // CONSULTATION, INPATIENT, PHARMACY, DIAGNOSTIC, REFUND, INSURANCE_PAYOUT
  amount                Float
  source                String            // RAZORPAY, CASH, PM_JAY, TPA_REIMBURSEMENT
  referenceId           String
  balanceAfter          Float?
  description           String
  postedAt              DateTime          @default(now())

  @@index([hospitalId])
  @@index([entryType])
  @@index([category])
}

model PaymentWebhookEvent {
  id                    String            @id @default(uuid())
  eventId               String            @unique
  eventType             String
  payload               String
  status                String            @default("PROCESSED")
  processedAt           DateTime          @default(now())

  @@index([eventId])
}

model PaymentAuditLog {
  id                    String            @id @default(uuid())
  action                String
  performedBy           String?
  role                  String?
  entityType            String
  entityId              String
  details               String?
  ipAddress             String?
  timestamp             DateTime          @default(now())

  @@index([action])
  @@index([entityId])
}
